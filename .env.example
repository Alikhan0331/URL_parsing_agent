# LLM (используется для fallback-классификации карточек, если структурная эвристика не сработала)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
USE_LLM_FALLBACK=true

# Общие настройки краулера
MAX_PAGES=5
REQUEST_TIMEOUT=15
REQUEST_DELAY_SECONDS=1.5
USER_AGENT=Mozilla/5.0 (compatible; URLParsingAgent/1.0)

# Odoo (пока не используется, заготовка на будущее)
ODOO_URL=
ODOO_DB=
ODOO_USERNAME=
ODOO_PASSWORD=
